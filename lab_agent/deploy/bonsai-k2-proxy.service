[Unit]
Description=Bonsai K2 Think request policy gateway
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/bonsai-agent/k2.env
ExecStart=/opt/bonsai-lab-agent/current/venv/bin/bonsai-k2-proxy
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

# systemd-journald does not run in these unprivileged containers - it exits
# 243/CREDENTIALS - so StandardOutput=journal discarded everything these three
# services ever said. The 38-day outage and the promoter's ten-second retry
# storm both had to be reconstructed from the database event ledger because of
# it. Log to a file the container can actually write.
StandardOutput=append:/srv/bonsai-agent/logs/bonsai-k2-proxy.log
StandardError=append:/srv/bonsai-agent/logs/bonsai-k2-proxy.log

[Install]
WantedBy=multi-user.target
